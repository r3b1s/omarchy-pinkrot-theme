# pinkrot for btop — Caelid palette: scarlet, ember, gold, pink, bruise.
# Ported from athena-dots/btop/themes/pinkrot.theme, extended with the keys
# omarchy's btop themes carry. No green, blue, teal or brown.

# Main background
theme[main_bg]="#190710"

# Main text color
theme[main_fg]="#f08a9b"

# Title color for boxes
theme[title]="#d40d40"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff3d6e"

# Selected item background/foreground
theme[selected_bg]="#3a1220"
theme[selected_fg]="#ffd4dc"

# Color of inactive/disabled text
theme[inactive_fg]="#8a4557"

# Text on top of graphs
theme[graph_text]="#d99aa8"

# Background of the percentage meters
theme[meter_bg]="#2a1019"

# Process box misc
theme[proc_misc]="#c07ab8"

# Box outline colors
theme[cpu_box]="#c07ab8"
theme[mem_box]="#ff9db0"
theme[net_box]="#ff3b5c"
theme[proc_box]="#d40d40"

# Divider line color
theme[div_line]="#6e3345"

# Temperature graph
theme[temp_start]="#ff9db0"
theme[temp_mid]="#d75fd7"
theme[temp_end]="#ff3b5c"

theme[cpu_start]="#c07ab8"
theme[cpu_mid]="#ff6f9c"
theme[cpu_end]="#ff3d6e"

theme[free_start]="#ff3d6e"
theme[free_mid]="#ff6f9c"
theme[free_end]="#c07ab8"

theme[cached_start]="#ff6f9c"
theme[cached_mid]="#c07ab8"
theme[cached_end]="#ff3d6e"

theme[available_start]="#d75fd7"
theme[available_mid]="#ff3b5c"
theme[available_end]="#ff3b5c"

theme[used_start]="#ff9db0"
theme[used_mid]="#c07ab8"
theme[used_end]="#ff6f9c"

theme[download_start]="#d75fd7"
theme[download_mid]="#ff3b5c"
theme[download_end]="#ff3b5c"

theme[upload_start]="#ff9db0"
theme[upload_mid]="#c07ab8"
theme[upload_end]="#ff6f9c"

theme[process_start]="#c07ab8"
theme[process_mid]="#ff6f9c"
theme[process_end]="#ff3d6e"

theme[gradient_color_0]="#0b0206"
theme[gradient_color_1]="#190710"
theme[gradient_color_2]="#2a1019"
theme[gradient_color_3]="#6e3345"
theme[gradient_color_4]="#8a4557"
theme[gradient_color_5]="#f08a9b"
theme[gradient_color_6]="#d99aa8"
theme[gradient_color_7]="#ffd4dc"
